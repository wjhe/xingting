[
  {
    "id": "yunmeng_roc_nest",
    "title": "雷鹏巢",
    "art": "thunder_roc",
    "region": [
      "yunmeng_marsh"
    ],
    "weight": 8,
    "conditions": {
      "realm_min": "jindan"
    },
    "text": "泽心一座孤峰直插云霄，峰顶雷光翻涌。一头雷鹏盘踞巢上，翼展遮天，巢中三枚青紫色的卵噼啪作响，眼看就要破壳。",
    "options": [
      {
        "text": "登峰夺翎",
        "result": "你御剑而上。雷鹏长唳一声，双翼一振，万道雷霆朝你倾泻而下。",
        "battle": {
          "enemy": "thunder_roc",
          "win": {
            "result": "雷鹏坠入泽中，你拔下它最完整的两根翎羽。再回头时，巢里三只刚破壳的雏鸟正睁着湿漉漉的眼睛看你。你收了剑，没有再动手。",
            "effects": [
              {
                "type": "item",
                "id": "roc_feather",
                "count": 2
              },
              {
                "type": "item",
                "id": "roc_jingpo",
                "count": 1
              }
            ]
          },
          "lose": {
            "result": "雷霆贯体，你从峰顶跌落，在泽底昏睡了不知多少年才醒。",
            "effects": [
              {
                "type": "lifespan",
                "value": -20
              }
            ]
          }
        }
      },
      {
        "text": "藏身峰下，静观雏鹏破壳",
        "check": {
          "attr": "shenshi",
          "dc": 9
        },
        "success": {
          "result": "雏鹏破壳那一刻，雷光如瀑。你以神识随之起伏，竟从中悟出几分雷法真意，修为大进。",
          "effects": [
            {
              "type": "cultivation",
              "value": 10000
            }
          ]
        },
        "fail": {
          "result": "一道雷霆劈偏了方向，正落在你藏身之处，你被劈得半身焦麻。",
          "effects": [
            {
              "type": "hp",
              "value": -50
            }
          ]
        }
      },
      {
        "text": "不惊扰它，绕路离开",
        "result": "你绕开孤峰。身后雷声隆隆，像一场迟迟不肯落下的雨。"
      }
    ]
  },
  {
    "id": "yunmeng_banyan_ferry",
    "title": "唤名老榕",
    "art": "tree_demon",
    "region": [
      "yunmeng_marsh"
    ],
    "weight": 5,
    "conditions": {
      "realm_min": "jindan"
    },
    "text": "泽中小洲上立着一株老榕，树下的渡口已荒废多年。渔民说，夜里撑船经过的人，常听见树下有人喊自己的名字，应了的，就再没回来。你刚踏上沙洲，便听见了自己的名字。",
    "options": [
      {
        "text": "应声，引它现身",
        "result": "你朗声应道：“我在此。”整株老榕骤然苏醒，万千根须破土而出。",
        "battle": {
          "enemy": "tree_demon",
          "win": {
            "result": "树妖枯萎，你从焦黑的树干里剖出一颗碧绿的心核。根须底下，压着几十条朽坏的渔船，从此这条水路再无人失踪。",
            "effects": [
              {
                "type": "item",
                "id": "tree_heart",
                "count": 1
              },
              {
                "type": "attr",
                "key": "xinjing",
                "value": 1
              }
            ]
          },
          "lose": {
            "result": "藤蔓缠住你的四肢，一点点汲取你的精元。等你挣断藤蔓逃出，鬓角已白了一片。",
            "effects": [
              {
                "type": "lifespan",
                "value": -25
              }
            ]
          }
        }
      },
      {
        "text": "闭口不应，斩断渡口",
        "check": {
          "attr": "xinjing",
          "dc": 9
        },
        "success": {
          "result": "你一言不发，一剑斩断渡口的木桩。呼唤声在身后越来越弱，最后化作一声叹息。你的心也跟着静了下来。",
          "effects": [
            {
              "type": "attr",
              "key": "xinjing",
              "value": 1
            }
          ]
        },
        "fail": {
          "result": "那声音越唤越像你娘。你终于没忍住，应了一声——等你回过神来，已在树下站了十五年。",
          "effects": [
            {
              "type": "lifespan",
              "value": -15
            }
          ]
        }
      },
      {
        "text": "退回船上，离开小洲",
        "result": "你撑船离去。那声音一路跟着你，直到雾里。"
      }
    ]
  },
