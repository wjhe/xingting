  {
    "id": "mountain_herb_garden",
    "title": "雾锁药圃",
    "art": "mountain_spring",
    "region": ["luoxia_mountain"],
    "weight": 5,
    "once": true,
    "conditions": { "realm_min": "lianqi" },
    "text": "山泉边有一圈半人高的白雾，雾里隐约可见整整齐齐的药畦。看样子是哪位前辈的药圃，主人多年未归，护园的禁制却还在运转。",
    "options": [
