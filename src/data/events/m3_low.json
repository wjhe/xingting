          "win": { "result": "赤狐负伤逃进了深山。你在它栖身的树洞里，翻出它这些年从过路人身上骗来的灵石。", "effects": [{ "type": "stone", "value": 90 }, { "type": "cultivation", "value": 50 }] },
          "lose": { "result": "你眼前一花，醒来时躺在树下，伞没了，钱袋也轻了一大截。", "effects": [{ "type": "stone", "value": -40 }, { "type": "hp", "value": -20 }] }
