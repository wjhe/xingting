    "once": true,
    "conditions": { "realm_min": "lianqi" },
    "text": "石洞口挂着一张磨盘大的蛛网，网中央裹着个人形的白茧，茧里还在微微挣动。洞内暗处，八只幽绿的眼睛一齐亮了起来。",
    "options": [
      {
        "text": "拔剑斩网救人",
        "battle": {
          "enemy": "poison_spider",
          "win": { "result": "毒蛛蜷着腿不动了。茧里剖出个采药的汉子，他把药篓里的灵草全倒给你，你又从洞口收了一捆蛛丝。", "effects": [{ "type": "item", "id": "herb_qingling", "count": 2 }, { "type": "item", "id": "spider_silk", "count": 2 }] },
          "lose": { "result": "蛛毒顺着伤口往上爬，你拼死逃出山洞，在溪边吐了半宿。", "effects": [{ "type": "hp", "value": -40 }, { "type": "lifespan", "value": -1 }] }
        }
      },
      {
        "text": "点起松枝浓烟熏洞",
        "check": { "attr": "shenshi", "dc": 7 },
        "success": { "result": "毒蛛受不了烟气，缩进了洞底。你趁机割开白茧，把人背了出来。汉子千恩万谢，塞给你一株灵草。", "effects": [{ "type": "item", "id": "herb_qingling", "count": 1 }, { "type": "attr", "key": "xinjing", "value": 1 }] },
        "fail": { "result": "风向一转，浓烟反倒灌了你一脸。毒蛛趁乱喷来一道毒丝，擦着你的手臂过去，火辣辣地疼。", "effects": [{ "type": "hp", "value": -20 }] }
      },
      {
        "text": "悄悄退走",
        "result": "你退出很远，那茧挣动的样子却总在眼前晃。",
        "effects": [{ "type": "attr", "key": "xinjing", "value": -1 }]
      }
    ]
  },
  {
