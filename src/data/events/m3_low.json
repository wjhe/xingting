[
  {
    "id": "village_thug_toll",
    "title": "流寇设卡",
    "art": "village_toll",
    "region": ["qingshi_village"],
    "weight": 6,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "两个外乡汉子把一根木杠横在村口，柴刀往槐树上一剁：“打今儿起，进出青石村，一人五块灵石！”赶集回来的乡亲们挤在杠子外头，谁也不敢吭声。",
    "options": [
      {
        "text": "抄起扁担上前",
        "result": "你把扁担一横，挡在乡亲们前头。",
        "battle": {
          "enemy": "village_thug",
          "win": { "result": "两个流寇抱着脑袋逃出了村。乡亲们你一把花生我一个鸡蛋，凑了些灵石硬塞给你。", "effects": [{ "type": "stone", "value": 25 }, { "type": "attr", "key": "xinjing", "value": 1 }] },
          "lose": { "result": "你被一刀背拍在肩上，疼得半天抬不起胳膊。流寇骂骂咧咧地搜走了你的灵石。", "effects": [{ "type": "hp", "value": -30 }, { "type": "stone", "value": -10 }] }
        }
      },
      {
        "text": "敲锣喊全村人来",
        "check": { "attr": "shenshi", "dc": 7 },
        "success": { "result": "你瞅准时机绕到祠堂敲响铜锣。几十个扛着锄头的乡亲涌到村口，两个流寇一看这阵势，扔下木杠就跑。", "effects": [{ "type": "attr", "key": "jiyuan", "value": 1 }] },
        "fail": { "result": "你刚摸到锣槌，就被流寇揪着后领拎了回来，挨了两记耳光。", "effects": [{ "type": "hp", "value": -15 }] }
      },
      {
        "text": "替大家交了钱（20 灵石）",
        "requires": { "stones": 20 },
        "result": "流寇掂着灵石扛杠走人。乡亲们嘴上道谢，眼里却有些失望。",
        "effects": [{ "type": "stone", "value": -20 }]
      }
    ]
  },
  {
    "id": "village_autumn_hunt",
    "title": "秋日围猎",
    "art": "village_farm",
    "region": ["qingshi_village"],
    "weight": 6,
    "conditions": { "realm_max": "lianqi" },
    "text": "秋收过后，村里的猎户老赵牵着两条黄狗来敲门：“后山的野猪拱了半坡红薯，几家合伙去围它。你腿脚快，来不来？”",
    "options": [
      {
        "text": "提叉打头阵",
        "battle": {
          "enemy": "wild_boar",
          "win": { "result": "你一叉扎进野猪肩胛，老赵补上一刀。按规矩打头阵的多分一腿肉，几户人家还凑了些灵石。", "effects": [{ "type": "item", "id": "boar_meat", "count": 2 }, { "type": "stone", "value": 15 }] },
          "lose": { "result": "野猪一头把你拱进了刺藤丛，等老赵把你拽出来，猪早跑没影了。", "effects": [{ "type": "hp", "value": -30 }] }
        }
      },
      {
        "text": "在后头敲锣赶围",
        "check": { "attr": "gengu", "dc": 7 },
        "success": { "result": "你跟着围子跑了满山，嗓子都喊哑了。野猪被撵进陷坑，老赵分了你一块肉。", "effects": [{ "type": "item", "id": "boar_meat", "count": 1 }] },
        "fail": { "result": "跑到半山腰你就喘不上气了，蹲在石头上看别人忙活，回来时两手空空。" }
      },
      { "text": "推说家里有活", "result": "老赵“嗐”了一声，牵着狗走了。傍晚村里飘起了炖肉的香味。" }
    ]
  },
  {
    "id": "village_melon_thief",
    "title": "瓜田夜守",
    "art": "village_farm",
    "region": ["qingshi_village"],
    "weight": 5,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "王老汉的西瓜接连丢了好几天，托你夜里帮忙看着。三更时分，瓜秧窸窸窣窣地动了，你一把揪住个瘦小的身影——是村尾刘寡妇家的二丫，怀里还抱着个瓜。",
    "options": [
      {
        "text": "送去王老汉那儿",
        "result": "王老汉没骂人，只叹了口气。为了谢你守夜，他还是给了你几块灵石。二丫一路哭着回了家。",
        "effects": [{ "type": "stone", "value": 10 }]
      },
      {
        "text": "替她把瓜钱垫上（10 灵石）",
        "requires": { "stones": 10 },
        "result": "第二天你把灵石放在王老汉的门槛上，什么也没说。往后二丫每回见你，都远远地冲你笑。",
        "effects": [{ "type": "stone", "value": -10 }, { "type": "attr", "key": "xinjing", "value": 1 }, { "type": "attr", "key": "jiyuan", "value": 1 }]
      },
      {
        "text": "放她走，当没看见",
        "result": "二丫抱着瓜跑远了。天亮时王老汉数瓜，又少了一个，你心里有些不是滋味。",
        "effects": [{ "type": "attr", "key": "xinjing", "value": -1 }]
      }
    ]
  },
  {
    "id": "village_wooden_sword",
    "title": "旧日木剑",
    "art": "village_eaves_rain",
    "region": ["qingshi_village"],
    "weight": 5,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "收拾屋子时，你从床底拖出一柄木剑。剑身上歪歪扭扭刻着几个字：“将来要当剑仙”。那是你七岁那年，拿娘的菜刀一笔一笔刻的。",
    "options": [
      {
        "text": "擦干净，挂回墙上",
        "result": "木剑挂在墙上，像个老朋友在看着你。那点少年意气，好像又回来了。",
        "effects": [{ "type": "attr", "key": "xinjing", "value": 1 }]
      },
      {
        "text": "送给隔壁眼巴巴的小娃",
        "result": "小娃抱着木剑满村跑，喊着“我是剑仙”。你笑着摇摇头，觉得这把剑总算找到了下一个主人。",
        "effects": [{ "type": "attr", "key": "jiyuan", "value": 1 }]
      },
      {
        "text": "照着当年的样子比划几招",
        "check": { "attr": "wuxing", "dc": 7 },
        "success": { "result": "孩童时自创的几招“剑法”稚拙可笑，你练着练着，却觉得体内那缕气息也跟着流转起来。", "effects": [{ "type": "cultivation", "value": 20 }] },
        "fail": { "result": "一个转身没站稳，木剑扫翻了灶台上的油罐。你收拾了一下午。" }
      }
    ]
  },
  {
    "id": "village_ghost_wall",
    "title": "月下迷途",
    "art": "village_well",
    "region": ["qingshi_village"],
    "weight": 5,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "你从邻村喝完喜酒回来，月亮又大又白。明明是走了十几年的路，可每走一阵，眼前总会冒出同一口古井。井沿上，好像蹲着个毛茸茸的影子。",
    "options": [
      {
        "text": "屏住气，盯住那影子",
        "check": { "attr": "shenshi", "dc": 8 },
        "success": { "result": "你看清了，是只黄鼬正冲你作揖。你猛一跺脚，它吓得一蹦，叼着的小布袋掉在地上。袋里竟有几块灵石，也不知是从谁家偷的。", "effects": [{ "type": "stone", "value": 15 }] },
        "fail": { "result": "你越盯越晕，绕着古井转到了鸡叫，脚底磨出了两个大泡。", "effects": [{ "type": "hp", "value": -15 }] }
      },
      {
        "text": "坐在井边等天亮",
        "result": "你靠着井沿打了个盹。醒来时露水打湿了衣裳，家门就在百步开外。",
        "effects": [{ "type": "hp", "value": -5 }, { "type": "attr", "key": "xinjing", "value": 1 }]
      }
    ]
  },
  {
    "id": "village_spirit_sparrow",
    "title": "檐上灵雀",
    "art": "village_eaves_rain",
    "region": ["qingshi_village"],
    "weight": 4,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "这几天总有只麻雀来啄你晒的谷子。仔细一看，它尾巴上有根羽毛泛着淡淡的青光，在雨里也不沾水。货郎说过，沾了灵气的鸟雀，坊市里有人收。",
    "options": [
      {
        "text": "每天撒一把谷子给它",
        "result": "灵雀吃惯了，常落在你肩头打盹。说来也怪，它在的时候，你吐纳格外顺畅。",
        "effects": [{ "type": "cultivation", "value": 20 }, { "type": "attr", "key": "jiyuan", "value": 1 }]
      },
      {
        "text": "设个竹筛扣住它",
        "check": { "attr": "shenshi", "dc": 7 },
        "success": { "result": "竹筛啪地扣下。货郎第二天上门，掏了一把灵石把灵雀拎走了。笼子里的鸟回头叫了一声，听着像在骂人。", "effects": [{ "type": "stone", "value": 30 }, { "type": "attr", "key": "jiyuan", "value": -1 }] },
        "fail": { "result": "灵雀扑棱一下飞了，从此再没来过。只剩谷子撒了一地。" }
      }
    ]
  },
  {
    "id": "village_widow_loan",
    "title": "求借盘缠",
    "art": "village_gate",
    "region": ["qingshi_village"],
    "weight": 5,
    "once": true,
    "conditions": { "realm_max": "lianqi" },
    "text": "村尾的孙大娘攥着衣角站在你家门口，半天才开口：“我家石头说想去山外拜师，路上要盘缠……我挨家借了一圈，还差三十块灵石。”她身后，一个黑瘦的少年低着头。",
    "options": [
      {
        "text": "借给她（30 灵石）",
        "requires": { "stones": 30 },
        "result": "孙大娘拉着石头给你磕头，你连忙扶住。石头抿着嘴说：“我一定还。”",
        "effects": [{ "type": "stone", "value": -30 }, { "type": "flag", "key": "low_loan_lent" }]
      },
      {
        "text": "教石头几句吐纳的口诀",
        "check": { "attr": "wuxing", "dc": 7 },
        "success": { "result": "你把自己摸索出的门道掰开揉碎讲给他听。教着教着，你自己也想通了一处关窍。", "effects": [{ "type": "cultivation", "value": 25 }] },
        "fail": { "result": "你讲得磕磕绊绊，石头听得一头雾水。孙大娘客客气气地道了谢，领着儿子走了。" }
      },
      { "text": "“我手头也紧。”", "result": "孙大娘连声说“不碍事”，转身去敲下一家的门了。" }
    ]
  },
  {
    "id": "village_loan_repaid",
    "title": "石头来信",
    "art": "village_farewell",
    "region": ["qingshi_village"],
    "weight": 15,
    "once": true,
    "conditions": { "flags": ["low_loan_lent"] },
    "text": "孙大娘一路小跑过来，手里举着一封信，笑得合不拢嘴：“石头进了外门！他托人捎了灵石回来，说头一份要还你！”布包沉甸甸的，比借出去的还多。",
    "options": [
      {
        "text": "收下，替石头高兴",
        "result": "你掂了掂布包，里头有四十块灵石。信的末尾，石头写着：“等我学成了，回来教村里的娃认字。”",
        "effects": [{ "type": "stone", "value": 40 }]
      },
      {
        "text": "“留着给石头添件冬衣吧。”",
        "result": "孙大娘抹着眼泪走了。那晚你打坐时，心里格外安宁。",
        "effects": [{ "type": "attr", "key": "xinjing", "value": 1 }, { "type": "attr", "key": "jiyuan", "value": 1 }]
      }
    ]
  },
  {
