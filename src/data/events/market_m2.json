    "options": [
      { "text": "“你究竟是谁？”", "result": "老丐只是笑。一阵风吹过，墙角空空荡荡，只剩一只破碗。", "effects": [{ "type": "meta_flag", "key": "heard_yunmeng" }, { "type": "attr", "key": "wuxing", "value": 1 }] }
