        "requires": {
          "stones": 300
        }
      },
      {
        "text": "帮他找出抄错的那一处",
        "check": {
          "attr": "wuxing",
          "dc": 9
        },
        "success": {
          "result": "你指出了错处。学徒感激不尽，偷偷把掌柜压箱底的一页破障丹方抄了一份给你。",
          "effects": [
            {
              "type": "item",
              "id": "danfang_pozhang",
              "count": 1
            }
          ]
        },
        "fail": {
          "result": "你翻来覆去也没找出错在哪儿。学徒叹了口气，抱着抄本走了。"
