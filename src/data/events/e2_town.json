[
  {
    "id": "e2b_chen_teacher",
    "title": "村塾先生",
    "art": "village_eaves_rain",
    "region": [
      "qingshi_village"
    ],
    "weight": 5,
    "once": true,
    "conditions": {
      "realm_max": "lianqi"
    },
    "text": "村塾的陈先生教了二十年书，前几日赶集，被坊市的测灵石照出一丝灵根。他四十好几了，捏着那张测灵的纸条在你家门口转了三圈，才红着脸问：“我这把年纪，还来得及么？”",
    "options": [
      {
        "text": "劝他去试试",
        "result": "陈先生把学堂托给了邻村的老秀才，背着书箱去了坊市。临走前，他朝你深深作了一揖。",
        "effects": [
          {
            "type": "flag",
            "key": "e2b_chen_met"
          },
          {
            "type": "attr",
            "key": "xinjing",
            "value": 1
          }
        ]
      },
      {
        "text": "说实话：这个年纪太难了",
        "result": "陈先生愣了半晌，笑着把纸条夹进书里：“也好，学堂里那几个娃，还等着我教完《千字文》。”他说这话时的神情，让你想了好些天。",
        "effects": [
          {
            "type": "attr",
            "key": "wuxing",
            "value": 1
          }
        ]
      }
    ]
  },
  {
    "id": "e2b_chen_stall",
    "title": "代笔先生",
    "art": "chen_stall",
    "region": [
      "qingyun_market"
    ],
    "weight": 18,
    "once": true,
    "conditions": {
      "realm_min": "lianqi",
      "flags": [
        "e2b_chen_met"
      ]
    },
    "text": "坊市墙根下支着个代写符箓底稿的小摊，摊主正是陈先生。他修了两年，还没摸到炼气的门槛，全靠一手好字糊口。今早符箓铺掌柜说他抄错一笔，扣了他整月的工钱，他攥着那张底稿，手直发抖。",
    "options": [
      {
        "text": "陪他去符箓铺讲理",
        "check": {
          "attr": "shenshi",
          "dc": 7
        },
        "success": {
          "result": "你凑近一看，那一笔墨色比别处新，是掌柜自己添的。当着一屋子客人，掌柜只得把工钱如数补上。",
          "effects": [
            {
              "type": "flag",
              "key": "e2b_chen_helped"
            },
            {
              "type": "attr",
              "key": "xinjing",
              "value": 1
            }
          ]
        },
        "fail": {
          "result": "你看不出破绽，掌柜反咬你们闹事，叫来巡卫，你赔了二十灵石才脱身。陈先生一路给你赔不是。",
          "effects": [
            {
              "type": "stone",
              "value": -20
            }
          ]
        }
      },
      {
        "text": "请他写一幅字（60 灵石）",
        "requires": {
          "stones": 60
        },
        "result": "陈先生推辞不过，提笔写了“守拙”二字。你把字挂在打坐的地方，每回心浮气躁时看上一眼，便能静下来。",
        "effects": [
          {
            "type": "stone",
            "value": -60
          },
          {
            "type": "flag",
            "key": "e2b_chen_helped"
          },
          {
            "type": "cultivation",
            "value": 60
          },
          {
            "type": "attr",
            "key": "xinjing",
            "value": 1
          }
        ]
      },
      {
        "text": "劝他回村教书",
        "result": "陈先生沉默良久，摇了摇头：“再试一年。”你走出很远回头看，他又埋头抄起了底稿。"
      }
    ]
  },
  {
