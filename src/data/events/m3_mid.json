  {
    "id": "market_sect_notice",
    "title": "山门告示",
    "art": "sect_gate",
    "region": [
      "qingyun_market"
    ],
    "weight": 10,
    "once": true,
    "conditions": {
      "realm_min": "lianqi"
    },
    "text": "坊市牌楼下新贴了一张告示，朱砂大字：“青云宗广纳外门弟子，不问出身。考核之地，黑风谷。”告示前挤满了人，一个背柴的少年踮着脚，扯扯你的袖子，问上面写的什么。",
    "options": [
      {
        "text": "念给少年听，顺手报名（50 灵石）",
        "requires": {
          "stones": 50
        },
        "result": "你一字一句念完，少年听到“黑风谷”三个字，缩着脖子走了。你交了五十灵石报名费，执事递给你一块木牌：“筑基之后，去黑风谷找考官。”",
        "effects": [
          {
            "type": "stone",
            "value": -50
          },
          {
            "type": "flag",
            "key": "mid_sect_signed"
          }
        ]
      },
      {
        "text": "散修自在，何必寄人篱下",
        "result": "你挤出人群。身后的执事还在吆喝，嗓子都喊哑了。"
      }
    ]
  },
