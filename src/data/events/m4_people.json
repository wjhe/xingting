[
  {
    "id": "mountain_meng_drunk",
    "title": "断剑醉客",
    "art": "drunk_swordsman",
    "region": ["luoxia_mountain"],
    "weight": 6,
    "once": true,
    "conditions": { "realm_min": "lianqi", "realm_max": "lianqi" },
    "text": "夜里你在山坳生了堆火，一个酒气冲天的中年人摇摇晃晃坐到对面，怀里抱着半截断剑。他自称孟寒秋，灌了口酒，冲你咧嘴一笑：“剑断了，人还没断——呵，罢了，喝酒。”",
    "options": [
      {
        "text": "陪他喝，听他讲那把剑",
        "result": "酒过三巡，他说起二十年前，师兄段沧盗走师门剑经，一剑斩断了他的“寒秋”。天亮时他已不见，火堆边的沙地上留着几道剑痕，你看了半晌，若有所悟。",
        "effects": [{ "type": "cultivation", "value": 80 }, { "type": "flag", "key": "p4_meng_met" }, { "type": "flag", "key": "p4_meng_kind" }]
      },
      {
        "text": "一把夺下他的酒葫芦",
        "check": { "attr": "xinjing", "dc": 7 },
        "success": {
          "result": "孟寒秋盯着你看了许久，忽然把葫芦里的酒全泼进火里，火苗蹿起三尺高。“二十年了，头一个敢抢我酒的，竟是个炼气小子。罢了，戒一戒试试。”",
          "effects": [{ "type": "attr", "key": "xinjing", "value": 1 }, { "type": "flag", "key": "p4_meng_met" }, { "type": "flag", "key": "p4_meng_kind" }, { "type": "flag", "key": "p4_meng_sober" }]
        },
        "fail": {
          "result": "你的手刚伸过去，就被断剑的剑脊敲在腕上，疼得直甩手。他抱着葫芦笑出了眼泪：“小子，再练二十年。”",
          "effects": [{ "type": "hp", "value": -10 }, { "type": "flag", "key": "p4_meng_met" }]
        }
      },
      {
        "text": "嫌他酒气熏人，挪个地方",
        "result": "你抱着铺盖走远了些。身后传来他含混的嘟囔：“罢了，喝酒。”",
        "effects": [{ "type": "flag", "key": "p4_meng_met" }]
      }
    ]
  },
  {
    "id": "valley_meng_trail",
    "title": "黑风寻仇",
    "art": "swordsman_wind",
    "region": ["heifeng_valley"],
    "weight": 20,
    "once": true,
    "conditions": { "realm_min": "zhuji", "flags": ["p4_meng_kind"] },
    "text": "黑风里有人喊你的名字。是孟寒秋，那半截断剑接上了新铸的剑身，接口处还看得见焊痕。他说追了半年，终于查到一伙劫修知道段沧的下落：“我一个人进去，十成里能出来三成。你来，能有五成。”",
    "options": [
      {
        "text": "随他闯进劫修窝",
        "result": "你们一前一后杀进山洞。",
        "battle": {
          "enemy": "rogue_cultivator",
          "win": {
            "result": "劫修头目跪地求饶，供出段沧早已投了血魔宗，藏身云梦泽。孟寒秋把搜出的灵石全推给你：“我只要消息。”",
            "effects": [{ "type": "stone", "value": 600 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
          },
          "lose": {
            "result": "你被法器震飞出去，是孟寒秋背着你杀出来的。他喘着粗气说：“是我拉你下的水，这笔账记我头上。”",
            "effects": [{ "type": "hp", "value": -40 }, { "type": "lifespan", "value": -3 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
          }
        }
      },
      {
        "text": "先用神识替他探探底",
        "check": { "attr": "shenshi", "dc": 9 },
        "success": {
          "result": "你的神识贴着岩壁探进去，摸清了每个劫修的位置。孟寒秋照你说的路线进出，拿到了口供：段沧投了血魔宗，藏在云梦泽。他把劫修的储物袋扔给你：“你出力最多。”",
          "effects": [{ "type": "stone", "value": 400 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
        },
        "fail": {
          "result": "神识被劫修察觉，洞中法器齐发。孟寒秋硬挡在你身前挨了两下，骂骂咧咧地带你撤了出来。",
          "effects": [{ "type": "hp", "value": -30 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
        }
      },
      {
        "text": "推说有事，不掺和",
        "result": "孟寒秋点点头，也不多说，提着剑独自走进了黑风里：“罢了，本就是我自己的事。”",
        "effects": [{ "type": "flag", "key": "p4_meng_s2" }]
      }
    ]
  },
  {
    "id": "valley_meng_ambush",
    "title": "困兽",
    "art": "valley_rogue",
    "region": ["heifeng_valley"],
    "weight": 20,
    "once": true,
    "conditions": { "realm_min": "zhuji", "flags": ["p4_meng_met"], "not_flags": ["p4_meng_kind"] },
    "text": "乱石后头传来兵刃声。一个中年剑修背靠岩壁，断剑横在胸前，身上挂了好几处彩，三个黑袍劫修正慢慢围上去。他瞥见你，眯了眯眼：“落霞山那个……罢了，记不清了，脸熟。”",
    "options": [
      {
        "text": "拔剑救人",
        "result": "你从劫修背后杀了进去。",
        "battle": {
          "enemy": "rogue_cultivator",
          "win": {
            "result": "劫修死的死、逃的逃。孟寒秋拄着断剑喘了半天，把劫修的储物袋丢给你：“落霞山那晚，我想起来了。今天这份情，我记住了。”",
            "effects": [{ "type": "stone", "value": 500 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
          },
          "lose": {
            "result": "你们俩被打得滚下山坡，劫修搜走了你身上的灵石。孟寒秋躺在乱石堆里笑了：“难兄难弟。行，这份情我记住了。”",
            "effects": [{ "type": "hp", "value": -40 }, { "type": "stone", "value": -200 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
          }
        }
      },
      {
        "text": "抛给他一颗回春丹",
        "requires": { "items": { "huichun_dan": 1 } },
        "result": "他接住丹药一口吞下，断剑一抖，硬生生杀开了一条路。临走前他回头冲你抱了抱拳：“这颗丹，我记下了。”",
        "effects": [{ "type": "item", "id": "huichun_dan", "count": -1 }, { "type": "flag", "key": "p4_meng_ally" }, { "type": "flag", "key": "p4_meng_s2" }]
      },
      {
        "text": "绕道走开",
        "result": "你绕过那片乱石。身后的兵刃声响了很久，然后忽然停了。",
        "effects": [{ "type": "flag", "key": "p4_meng_s2" }]
      }
    ]
  },
  {
    "id": "yunmeng_meng_duel",
    "title": "泽上决剑",
    "art": "marsh_demon",
    "region": ["yunmeng_marsh"],
    "weight": 25,
    "once": true,
    "conditions": { "realm_min": "jindan", "flags": ["p4_meng_ally"] },
    "text": "孟寒秋托人捎来口信，约你泽心相见。两条船隔水相对，对面船头立着个血袍人，正是段沧。他面色灰败，每咳一声，袍上的血纹就暗一分。孟寒秋拔出那柄接过的剑，声音很平：“二十年了，今天了结。”",
    "options": [
      {
        "text": "与他并肩出剑",
        "result": "你踏上船头，与孟寒秋一左一右。",
        "battle": {
          "enemy": "demon_cultivator",
          "win": {
            "result": "段沧沉入泽底。孟寒秋从他的储物袋里翻出剑经和一袋灵石，一并塞给你：“剑经我背得出来，留着也是压箱底。你拿去，别学我把剑弄断。”",
            "effects": [{ "type": "item", "id": "book_taiyi", "count": 1 }, { "type": "stone", "value": 2500 }, { "type": "flag", "key": "p4_meng_done" }]
          },
          "lose": {
            "result": "血幡卷来，孟寒秋拼着硬挨一记把你推出了战圈。段沧趁乱遁走，你们在渔村养了大半年的伤。",
            "effects": [{ "type": "hp", "value": -50 }, { "type": "lifespan", "value": -15 }, { "type": "flag", "key": "p4_meng_done" }]
          }
        }
      },
      {
        "text": "抱剑旁观，这是他的仗",
        "result": "孟寒秋独自踏水而去，攒了二十年的一剑斩落，段沧应声坠入泽中。他回来时左袖空了，却笑得像个少年：“剑断过一回，手再断一只，也就那么回事。”那一剑你只看了一遍，却再也忘不掉。",
        "effects": [{ "type": "cultivation", "value": 8000 }, { "type": "flag", "key": "p4_meng_done" }]
      },
      {
        "text": "按住他的剑：“他已经快死了。”",
        "requires": { "flags": ["p4_meng_sober"], "hint": "他眼里只剩仇人，听不进劝" },
        "result": "剑停在半空。段沧怔了半晌，从怀里摸出剑经抛过来：“偷了你二十年，一页也没练成。”孟寒秋接住，这回没去摸酒葫芦，转手把剑经递给你：“剑断了，人还没断。这东西困了我二十年，交给你，我就自在了。”",
        "effects": [{ "type": "item", "id": "book_taiyi", "count": 1 }, { "type": "attr", "key": "xinjing", "value": 1 }, { "type": "flag", "key": "p4_meng_done" }]
      }
    ]
  },
  {
