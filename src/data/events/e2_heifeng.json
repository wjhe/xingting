          {
            "type": "flag",
            "key": "e2d_seek_1"
          },
          {
            "type": "item",
            "id": "fire_talisman",
            "count": 2
          }
        ]
      },
      {
        "text": "先收三百灵石酬金再说",
        "result": "少女咬咬牙，从竹篓底摸出个布包，数了三百灵石给你，都是碎灵石，有几块还沾着泥。你收下时，心里有点不是滋味。",
        "effects": [
          {
            "type": "stone",
            "value": 300
          },
          {
            "type": "flag",
            "key": "e2d_seek_1"
          },
          {
            "type": "attr",
            "key": "xinjing",
            "value": -1
          }
        ]
      },
      {
        "text": "黑风谷吞人不吐骨头，劝她回去",
        "result": "你劝她死了这条心。少女没吭声，只把画像一张张捡起来，抱在怀里，又坐回了石头下。"
      }
    ]
  },
  {
