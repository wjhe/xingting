[
  {
    "id": "e2a_qiao_song",
    "title": "樵歌",
    "art": "night_camp",
    "region": [
      "luoxia_mountain"
    ],
    "weight": 6,
    "once": true,
    "conditions": {
      "realm_min": "lianqi",
      "realm_max": "zhuji"
    },
    "text": "天擦黑时，你在山道边生了堆火。一个挑柴的老樵夫歇在火边，抽着旱烟哼起一支怪调：“三叠水，一线天，石门不开问灯盏；灯盏不照人间事，只照山中第七年。”他说这是师父教的，唱了六十年，没一个人听懂。",
    "options": [
      {
        "text": "跟着他的调子，一句句默记",
        "check": {
          "attr": "wuxing",
          "dc": 6
        },
        "success": {
          "result": "老樵夫唱得兴起，连唱了五遍。你记下词时，发觉这调子一起一伏，竟暗合吐纳的节拍。",
          "effects": [
            {
              "type": "flag",
              "key": "e2a_song"
            },
            {
              "type": "cultivation",
              "value": 30
            }
          ]
        },
        "fail": {
          "result": "调子七拐八绕，你记了上句忘下句。老樵夫哈哈一笑，挑起柴担走了。"
        }
      },
      {
        "text": "分他半块干粮，问问他的师父",
        "result": "老樵夫嚼着干粮说，师父是个怪人，教他砍了六年柴，第七年一早进了山，再没回来。临别前，他又把那支歌慢慢唱了一遍。",
        "effects": [
          {
            "type": "flag",
            "key": "e2a_song"
          }
        ]
      },
      {
        "text": "嫌他吵，挪远些歇息",
        "result": "你挪到另一块石头后面。那怪调断断续续，唱到半夜才停。"
      }
    ]
  },
  {
    "id": "e2a_qiao_falls",
    "title": "三叠水",
    "art": "mountain_spring",
    "region": [
      "luoxia_mountain"
    ],
    "weight": 18,
    "once": true,
    "conditions": {
      "realm_min": "lianqi",
      "flags": [
        "e2a_song"
      ]
    },
    "text": "落霞山深处，一道瀑布分三叠落下，第二叠后的崖壁裂开一线天光——正是歌里唱的地方。你钻进水帘，里头是一扇石门，门上浮雕着一盏铜灯，灯下排着七个指头大的小孔。",
    "options": [
      {
        "text": "照歌里说的，从灯盏往下数",
        "check": {
          "attr": "wuxing",
          "dc": 7
        },
        "success": {
          "result": "“石门不开问灯盏”——你从灯芯数起，按下第七个孔。石门里咔嗒一响，缓缓让开一道缝。",
          "effects": [
            {
              "type": "flag",
              "key": "e2a_door"
            }
          ]
        },
        "fail": {
          "result": "你按错了孔，门缝里喷出一股激流，把你冲下了一叠瀑布。湿淋淋地爬回来，换个方向重数，门总算开了。",
          "effects": [
            {
              "type": "hp",
              "value": -25
            },
            {
              "type": "flag",
              "key": "e2a_door"
            }
          ]
        }
      },
      {
        "text": "运足力气，硬推石门",
        "check": {
          "attr": "gengu",
          "dc": 8
        },
        "success": {
          "result": "你用肩膀抵住石门，一寸一寸推开，推完半边身子都麻了。",
          "effects": [
            {
              "type": "hp",
              "value": -10
            },
            {
              "type": "flag",
              "key": "e2a_door"
            }
          ]
        },
        "fail": {
          "result": "石门纹丝不动，肩膀倒撞得青紫。等你缓过劲来，石门竟缓缓沉进了山壁，再也寻不见一道缝。",
          "effects": [
            {
              "type": "hp",
              "value": -20
            }
          ]
        }
      },
      {
        "text": "此地蹊跷，原路退出",
        "result": "你退出水帘，回头望了一眼。轰隆隆的水声里，像是有人在哼那支歌。"
      }
    ]
  },
  {
    "id": "e2a_qiao_lamp",
    "title": "石室灯盏",
    "art": "bronze_lamp",
    "region": [
      "luoxia_mountain"
    ],
    "weight": 18,
    "once": true,
    "conditions": {
      "realm_min": "lianqi",
      "flags": [
        "e2a_door"
      ]
    },
    "text": "石室正中的石台上搁着一盏青铜灯，灯油早干了，灯座刻着“第七年”。四壁刻着六幅吐纳图，第七面墙却是空的。你刚要伸手，身后水帘一分，一个刀疤散修钻了进来：“跟了你三天，辛苦。灯归我。”",
    "options": [
      {
        "text": "拔剑护灯",
        "result": "你横身挡在石台前。",
        "battle": {
          "enemy": "bandit",
          "win": {
            "result": "散修捂着伤口逃出水帘，慌乱中落下一只钱袋。你把铜灯揣进怀里，灯身微微发温。",
            "effects": [
              {
                "type": "stone",
                "value": 60
              },
              {
                "type": "flag",
                "key": "e2a_lamp"
              }
            ]
          },
          "lose": {
            "result": "他一脚把你踹倒，抄起铜灯就跑。刚出水帘，他骂了一声又把灯扔了回来——这灯在他手里冰凉死沉，半点灵气也没有。",
            "effects": [
              {
                "type": "hp",
                "value": -35
              },
              {
                "type": "flag",
                "key": "e2a_lamp"
              }
            ]
          }
        }
      },
      {
        "text": "说灯是空的，请他一起参详壁画",
        "check": {
          "attr": "xinjing",
          "dc": 7
        },
        "success": {
          "result": "你盘膝坐下，不急不躁地讲起第一幅图。散修听了半晌，竟也跟着坐下，天亮时朝你一拱手走了，灯没碰。",
          "effects": [
            {
              "type": "cultivation",
              "value": 60
            },
            {
              "type": "flag",
              "key": "e2a_lamp"
            }
          ]
        },
        "fail": {
          "result": "他听了两句就不耐烦，一刀背拍在你后颈。醒来时人已不见，铜灯还在石台上——大概是嫌它是个破铜器。",
          "effects": [
            {
              "type": "hp",
              "value": -25
            },
            {
              "type": "flag",
              "key": "e2a_lamp"
            }
          ]
        }
      },
      {
        "text": "灯给你，我不要了",
        "result": "散修揣着铜灯扬长而去。你独自对着六幅壁画坐了一夜，学到了一点吐纳的门道。",
        "effects": [
          {
            "type": "cultivation",
            "value": 40
          }
        ]
      }
    ]
  },
  {
    "id": "e2a_qiao_seventh",
    "title": "第七年",
    "art": "bronze_lamp",
    "region": [
