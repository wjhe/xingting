{
  "name": "wendao-changsheng",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wechat": "tsc --noEmit && vite build --config vite.wechat.config.ts && node scripts/copy-wechat-template.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "sim:raising": "tsx scripts/stargarden-simulate.ts",
    "test:raising": "vitest run tests/raising.test.ts tests/raising-story.test.ts tests/raising-ads.test.ts tests/raising-balance.test.ts",
    "smoke:raising": "node scripts/stargarden-smoke.mjs",
    "assets:raising": "python scripts/stargarden-assets.py",
    "assets": "python -I scripts/assets.py",
    "build:android": "node scripts/build-android.mjs",
    "android:res": "python -I scripts/android_res.py",
    "assets:raising:production": "python scripts/stargarden-production-assets.py",
    "catalog:raising": "tsx scripts/stargarden-catalog.ts",
    "smoke:raising:content": "node scripts/stargarden-content-smoke.mjs",
    "smoke:raising:schedule": "node scripts/stargarden-schedule-smoke.mjs",
    "smoke:raising:opening": "node scripts/stargarden-opening-smoke.mjs",
    "smoke:raising:music": "node scripts/stargarden-music-smoke.mjs",
    "smoke:raising:ads": "node scripts/stargarden-ads-smoke.mjs",
    "music:raising": "python scripts/stargarden-music-build.py",
    "sfx:raising:build": "python scripts/stargarden-sfx-ai.py --process-only",
    "sfx:raising:generate": "python scripts/stargarden-sfx-ai.py --generate"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^24.19.2",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
